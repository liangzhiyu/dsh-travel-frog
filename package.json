{
  "name": "dsh-travel-frog",
  "version": "0.1.0",
  "description": "蛙旅：DeepSeek Harness 里的低打扰旅行与明信片收藏伙伴",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "build": "node tools/build.mjs",
    "test": "node --test test/*.test.mjs",
    "check": "node tools/build.mjs && node --check client.js && node --check index.js && node --test test/*.test.mjs",
    "prepack": "node tools/build.mjs",
    "test:browser": "node tools/browser-smoke.mjs"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js"
  },
  "files": [
    "index.js",
    "core.js",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "docs/"
  ],
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "travel",
    "companion"
  ],
  "engines": {
    "node": ">=24.9",
    "dsh": ">=0.2.1-rc.2 <0.3.0-0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    },
    "catalog": {
      "summary": {
        "zh": "准备行囊，等待归来，收藏原创明信片。可主动使用宿主模型写游记。",
        "en": "A quiet travel companion with postcards and optional model-written stories."
      },
      "category": "ui"
    }
  },
  "devDependencies": {
    "playwright": "1.62.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/liangzhiyu/dsh-travel-frog.git"
  },
  "homepage": "https://github.com/liangzhiyu/dsh-travel-frog#readme"
}
